# Copy this file to ".env" and adjust as needed. Never commit the real ".env".

PORT=3000
NODE_ENV=development

# Comma-free single origin allowed to call the API from a browser (leave blank to allow same-origin only)
ALLOWED_ORIGIN=

# ---- Optional: email notification for new enquiries ----
# Leave SMTP_HOST empty to skip email and only save enquiries to server/data/inquiries.json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=dropflowwatertaps@gmail.com
